[Unit]
Description=Geolinux: install default desktop apps from Flathub
Wants=network-online.target
After=network-online.target

[Service]
# Not a oneshot: the installer exits 0 even when Flathub is unreachable, so the
# unit itself verifies the end state and retries on slow/flaky networks. When
# QGIS is already installed the whole thing is a single local flatpak lookup.
Type=simple
ExecStart=/bin/sh -c 'flatpak info --system org.qgis.qgis >/dev/null 2>&1 || /usr/libexec/geolinux-flatpak-setup; flatpak info --system org.qgis.qgis >/dev/null 2>&1'
Restart=on-failure
RestartSec=2min

[Install]
WantedBy=multi-user.target
