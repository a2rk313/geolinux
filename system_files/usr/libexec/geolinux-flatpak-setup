#!/bin/bash
# Installs the desktop core apps, QGIS and Zen Browser as Flathub flatpaks. Runs
# on every boot via geolinux-flatpak-setup.service; already-installed apps exit
# fast, failures retry on the next boot. The desktop set is chosen by which
# display manager the image ships (gdm = GNOME, plasmalogin = KDE); QGIS and Zen
# are installed on both editions. GRASS is bundled with QGIS; SAGA is opt-in
# (cpak container).
set -u

flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || exit 0

APPS=()
if rpm -q gdm >/dev/null 2>&1; then
  APPS+=(
    org.gnome.baobab
    org.gnome.Calendar
    org.gnome.Calculator
    org.gnome.Characters
    org.gnome.clocks
    org.gnome.Connections
    org.gnome.Contacts
    org.gnome.Decibels
    org.gnome.font-viewer
    org.gnome.Logs
    org.gnome.Loupe
    org.gnome.Maps
    org.gnome.Papers
    org.gnome.Showtime
    org.gnome.Snapshot
    org.gnome.SimpleScan
    org.gnome.TextEditor
    org.gnome.Weather
  )
elif rpm -q plasma-login-manager >/dev/null 2>&1; then
  APPS+=(
    org.kde.ark
    org.kde.dolphin
    org.kde.filelight
    org.kde.kcharselect
    org.kde.kfind
    org.kde.kwrite
    org.kde.kwalletmanager5
  )
fi

# Defaults for both editions — QGIS bundles GRASS 8.4, GDAL and PROJ. Everything
# else is opt-in: geolinux-gis --list (SAGA runs in a cpak container)
APPS+=(
  org.qgis.qgis/x86_64/stable
  app.zen_browser.zen
)

for app in "${APPS[@]}"; do
  flatpak install -y --system flathub "$app" \
    || echo "WARNING: flatpak install $app failed; retrying on next boot" >&2
done
